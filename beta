do
    local function releaseLantern()
        if NavigationOwner == "lantern" then
            NavigationOwner = nil
            ClearHover()
        end
    end
    local function lanternEvent()
        local origin = workspace:FindFirstChild("_WorldOrigin")
        local locations = origin and origin:FindFirstChild("Locations")
        return locations and locations:FindFirstChild("Freezing Hydra Island")
    end
    local function findUnlitLantern()
        local map = workspace:FindFirstChild("Map")
        local waterfall = map and map:FindFirstChild("Waterfall")
        local island = waterfall and waterfall:FindFirstChild("IslandModel")
        local dojo = island and island:FindFirstChild("DojoAddition")
        local names = { Green = "RelicGreen", Red = "RelicRed", Yellow = "RelicYellow" }
        for _, lantern in ipairs(dojo and dojo:GetChildren() or {}) do
            local relic = names[lantern.Name] and lantern:FindFirstChild(names[lantern.Name])
            local fire = relic and relic:FindFirstChild("RelicFire")
            local attachment = fire and fire:FindFirstChild("Attachment")
            local particle = attachment and attachment:FindFirstChild("Particle_1")
            if particle and not particle.Enabled then
                local prompt = lantern:FindFirstChildWhichIsA("ProximityPrompt", true)
                local part = lantern.PrimaryPart or lantern:FindFirstChildWhichIsA("BasePart", true)
                if prompt and part then return prompt, part end
            end
        end
    end
    local function lanternStep()
        if not _G.IgniteLantern or not lanternEvent() or EnchantHandoff.requested then releaseLantern(); return end
        if NavigationOwner and NavigationOwner ~= "lantern" then return end
        local client = workspace:FindFirstChild("HydraIslandClient")
        local remote = client and client:FindFirstChild("RemoteFunction")
        if not remote then return end
        local complete = remote:InvokeServer("Interacted")
        if not _G.IgniteLantern or not lanternEvent() or EnchantHandoff.requested then releaseLantern(); return end
        if NavigationOwner and NavigationOwner ~= "lantern" then return end
        if complete then releaseLantern(); return end
        local _, root, hum = GetCharacterParts()
        if not root or not hum or hum.Health <= 0 then releaseLantern(); return end
        if NavigationOwner ~= "lantern" then
            NavigationOwner = "lantern"
            if CurrentTween then pcall(function() CurrentTween:Cancel() end) end
            ClearHover()
            task.wait(0.2)
        end
        local function cancelled()
            return not _G.IgniteLantern or not lanternEvent() or EnchantHandoff.requested or NavigationOwner ~= "lantern"
        end
        if cancelled() then releaseLantern(); return end
        local destination = CFrame.new(5623.16259765625, 1207.139404296875, 913.849609375)
        if (root.Position - destination.Position).Magnitude > 300 then
            _tp(destination, cancelled, true)
            return
        end
        local prompt, part = findUnlitLantern()
        if not prompt then
            pcall(function() LocalPlayer:RequestStreamAroundAsync(destination.Position, 2) end)
            return
        end
        if (root.Position - part.Position).Magnitude > 8 then
            _tp(part.CFrame, function() return cancelled() or not part.Parent end, true)
            return
        end
        if cancelled() or not prompt.Parent or not prompt.Enabled then return end
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(math.max(prompt.HoldDuration, 0) + 0.1)
            prompt:InputHoldEnd()
        end
    end
    task.spawn(function()
        while true do
            local ok = pcall(lanternStep)
            if not ok then releaseLantern() end
            task.wait(_G.IgniteLantern and 0.5 or 1)
        end
    end)
end
