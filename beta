            end
            ParkShotPose()
            task.wait()
            local ErrFire = BowError(ReadHeartPos())
            if ErrFire ~= nil and ErrFire > math.rad(3) then
                SetStatus("Enganche: la proa se movió, vuelvo a alinearla")
