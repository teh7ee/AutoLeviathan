local function RJR_InstallAimHook()
    if Aim.HookReady then
        return true
    end
    if Aim.HookFailed then
        return false
    end
    if type(getrawmetatable) ~= "function" or type(newcclosure) ~= "function" then
        Aim.HookFailed = true
        return false
    end
    local GetMethod = getnamecallmethod
    local CheckCaller = (type(checkcaller) == "function") and checkcaller or nil
    local TypeOf = typeof
    local ok = pcall(function()
        local MT = getrawmetatable(game)
        local OldNameCall = MT.__namecall
        setreadonly(MT, false)
        MT.__namecall = newcclosure(function(self, ...)
            if not Aim.On or not RJR_AimGate() then
                return OldNameCall(self, ...)
            end
            local method = GetMethod()
            if method ~= "FireServer" and method ~= "InvokeServer" then
                return OldNameCall(self, ...)
            end
            if CheckCaller and CheckCaller() then
                return OldNameCall(self, ...)
            end
            local nm = self.Name
            if nm ~= "RemoteEvent" and nm ~= "RemoteFunction" and nm ~= "CommE" then
                return OldNameCall(self, ...)
            end
            local n = select("#", ...)
            if n == 0 then
                return OldNameCall(self, ...)
            end
            local first = ...
            if TypeOf(first) == "boolean" then
                return OldNameCall(self, ...)
            end
            local pos = RJR_AimPoint()
            if not pos or pos.X ~= pos.X then
                return OldNameCall(self, ...)
            end
            local args = table.pack(...)
            local changed = false
            for i = 1, n do
                if TypeOf(args[i]) == "Vector3" then
                    args[i] = pos
                    changed = true
                end
            end
            if not changed then
                return OldNameCall(self, ...)
            end
            Aim.Rewrites = Aim.Rewrites + 1
            return OldNameCall(self, table.unpack(args, 1, n))
        end)
        setreadonly(MT, true)
        Aim.MT = MT
        Aim.Old = OldNameCall
    end)
    if not ok then
        Aim.HookFailed = true
        return false
    end
    Aim.HookReady = true
    return true
