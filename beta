function CombatAPI.CastDirect(key, hold)
    local name = typeof(key) == "EnumItem" and key.Name or (type(key) == "string" and key:upper())
    if not name or not CombatAPI.DirectKeys[name] then
        return false
    end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool or type(debug) ~= "table" or type(debug.getupvalue) ~= "function" then
        return false
    end
    local g = CombatAPI.GameGlobal()
    local casFunc = g and g.casFunc
    if type(casFunc) ~= "function" then
        return false
    end
    local checked, owner = pcall(debug.getupvalue, casFunc, 1)
    if not checked or owner ~= tool then
        return false
    end
    local code = Enum.KeyCode[name]
    local changed = Instance.new("BindableEvent")
    local input = {
        KeyCode = code,
        UserInputState = Enum.UserInputState.Begin,
        Changed = changed.Event,
        Position = Vector2.zero,
    }
    local failed = false
    task.spawn(function()
        if not pcall(casFunc, "DevilFruit", Enum.UserInputState.Begin, input, code) then
            failed = true
        end
        changed:Destroy()
    end)
    task.wait(tonumber(hold) or CombatAPI.SkillKeyHold)
    input.UserInputState = Enum.UserInputState.End
    changed:Fire("UserInputState")
    return not failed
end
function CombatAPI.SendKey(key, hold)
