            DriverSeat.Throttle, DriverSeat.ThrottleFloat = 0, 0
            DriverSeat.Steer, DriverSeat.SteerFloat = 0, 0
            DriverSeat.CFrame = CFrame.new(Target) * CFrame.Angles(0, AimYaw(flat), 0)
