function InfoUI.Collect()
    local d = {}
    local S = GetBribeStatus()
    if S == nil then
        d.bribe = { T("bribe.unknown"), "idle" }
    elseif S == -1 then
        d.bribe = { T("bribe.cd"), "warn" }
    elseif S == 5 then
        d.bribe = { T("bribe.done"), "good" }
    else
        d.bribe = { tostring(S) .. " / 5", "info" }
    end
    local boat = (_G.Mode == "Capitán") and GetOwnBoat() or GetCaptainBoat()
    if boat then
        local n = CountTeammatesOnBoat(boat)
        d.crew = { tostring(n) .. " / 4", n >= 4 and "good" or "warn" }
    else
        d.crew = { T("detail.no.boat"), "bad" }
    end
    local LV = SeaAPI.Leviathan_Find()
    local Map = workspace:FindFirstChild("Map")
    if LV then
        local HP = SeaAPI.Leviathan_GetHP(LV)
        local Max = LV:GetAttribute("MaxHealth")
        local Hum = LV:FindFirstChildOfClass("Humanoid")
        if Hum and Hum.MaxHealth > 0 then
            Max = Hum.MaxHealth
        end
        InfoUI.LvMax[LV] = math.max(InfoUI.LvMax[LV] or 0, tonumber(Max) or 0, HP or 0)
        local Frac = (HP and InfoUI.LvMax[LV] > 0) and math.clamp(HP / InfoUI.LvMax[LV], 0, 1) or nil
        d.lv = { HP and (T("target.hp") .. " " .. string.format("%.0f", HP)) or T("target.spawned"), "bad", Frac }
    elseif Map and Map:FindFirstChild("LeviathanGate") then
        d.lv = { T("target.gate"), "warn" }
    else
        d.lv = { T("target.not.spawned"), "idle" }
    end
    local Heart = Map and Map:FindFirstChild("FrozenHeart")
    if Heart then
        if GetHeartPos(Heart) and IsFrozenHeartHarpooned() then
            d.heart = { T("target.hooked"), "good" }
        else
            d.heart = { T("target.spawned"), "warn" }
        end
    else
        d.heart = { T("target.not.spawned"), "idle" }
    end
    d.status = (StatusText ~= "" and StatusText) or "-"
    d.running = _G.AutoLeviathanFull and true or false
    d.mode = ModeDisplay()
    return d
end
